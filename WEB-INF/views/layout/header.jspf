<%@ page pageEncoding="UTF-8" session="false" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions" %>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><c:out value="${not empty pageTitle ? pageTitle : 'BrewLab'}"/></title>
  <link rel="manifest" href="${pageContext.request.contextPath}/manifest.webmanifest">
  <link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/brewlab.css">
</head>
<body>
<a class="skip-link" href="#contenido-principal">Saltar al contenido principal</a>
<div class="app-shell">
  <aside class="app-sidebar" aria-label="Navegación del laboratorio">
    <div>
      <div class="brand-block">
        <span class="brand-mark" aria-hidden="true">BL</span>
        <div>
          <div class="brand-title">BrewLab</div>
          <div class="brand-subtitle">Laboratorio de Especialidad</div>
        </div>
      </div>

      <div class="nav-section-label">Estación de trabajo</div>
      <nav aria-label="Secciones principales">
        <ul class="nav-list" id="main-nav-list">
          <li>
            <a class="nav-link ${activeNav == 'inicio' ? 'is-active' : ''}"
               href="${pageContext.request.contextPath}/app/inicio">
              <span>Panel de Laboratorio</span>
            </a>
          </li>
          <c:if test="${not empty applicationScope.navCafesEnabled}">
            <li>
              <a class="nav-link ${activeNav == 'cafes' ? 'is-active' : ''}"
                 href="${pageContext.request.contextPath}/app/cafes">
                <span>Biblioteca de Cafés</span>
              </a>
            </li>
          </c:if>
          <c:if test="${not empty applicationScope.navEquiposEnabled}">
            <li>
              <a class="nav-link ${activeNav == 'equipos' ? 'is-active' : ''}"
                 href="${pageContext.request.contextPath}/app/equipos">
                <span>Equipos y Agua</span>
              </a>
            </li>
            <li>
              <a class="nav-link ${activeNav == 'recetas' ? 'is-active' : ''}"
                 href="${pageContext.request.contextPath}/app/recetas">
                <span>Recetas y Métodos</span>
              </a>
            </li>
          </c:if>
          <c:if test="${not empty applicationScope.navPreparacionEnabled}">
            <li>
              <a class="nav-link ${activeNav == 'preparacion' ? 'is-active' : ''}"
                 href="${pageContext.request.contextPath}/app/preparacion">
                <span>Asistente de Preparación</span>
              </a>
            </li>
          </c:if>
          <c:if test="${not empty applicationScope.navCatacionEnabled}">
            <li>
              <a class="nav-link ${activeNav == 'catacion' ? 'is-active' : ''}"
                 href="${pageContext.request.contextPath}/app/catacion">
                <span>Laboratorio Sensorial</span>
              </a>
            </li>
          </c:if>
          <c:if test="${not empty applicationScope.navAnalisisEnabled}">
            <li>
              <a class="nav-link ${activeNav == 'analisis' ? 'is-active' : ''}"
                 href="${pageContext.request.contextPath}/app/analisis">
                <span>Análisis y Comparador</span>
              </a>
            </li>
            <li>
              <a class="nav-link ${activeNav == 'experimentos' ? 'is-active' : ''}"
                 href="${pageContext.request.contextPath}/app/experimentos">
                <span>Experimentos</span>
              </a>
            </li>
          </c:if>
          <li>
            <a class="nav-link ${activeNav == 'ajustes' ? 'is-active' : ''}"
               href="${pageContext.request.contextPath}/app/ajustes">
              <span>Configuración y Respaldo</span>
            </a>
          </li>
        </ul>
      </nav>
    </div>

    <div class="sidebar-footer">
      <c:if test="${not empty currentUser}">
        <div class="user-pill">
          <span class="user-avatar" aria-hidden="true"><c:out value="${currentUser.initial}"/></span>
          <div class="user-meta">
            <div class="user-name"><c:out value="${currentUser.displayName}"/></div>
            <div class="user-email"><c:out value="${currentUser.email}"/></div>
          </div>
        </div>
        <form method="post" action="${pageContext.request.contextPath}/auth/salir">
          <input type="hidden" name="_csrf" value="${fn:escapeXml(csrfToken)}">
          <button type="submit" class="btn btn-secondary btn-sm" style="width:100%;">Cerrar sesión JWT</button>
        </form>
      </c:if>
    </div>
  </aside>

  <div class="app-main">
    <header class="app-topbar">
      <div>
        <h1><c:out value="${not empty pageHeading ? pageHeading : pageTitle}"/></h1>
      </div>
      <div class="cluster" aria-label="Leyenda de tipos de dato">
        <span class="badge badge-planned" title="Parámetro objetivo definido en la receta">Previsto</span>
        <span class="badge badge-measured" title="Valor real medido o registrado en la sesión">Medido</span>
        <span class="badge badge-estimated" title="Sugerencia calculada por reglas explícitas">Estimado</span>
        <span class="badge badge-preference" title="Respuesta afectiva personal separada de la descripción">Preferencia</span>
      </div>
    </header>

    <main id="contenido-principal" class="app-content">
      <c:if test="${not empty flashMessage}">
        <div class="alert alert-${flashType == 'error' ? 'error' : (flashType == 'warn' ? 'warn' : (flashType == 'info' ? 'info' : 'success'))}"
             role="status">
          <span><c:out value="${flashMessage}"/></span>
        </div>
      </c:if>
