<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1"
         metadata-complete="true">

  <display-name>BrewLab — Laboratorio Digital de Café de Especialidad</display-name>

  <listener>
    <listener-class>com.brewlab.app.AppBootstrapListener</listener-class>
  </listener>

  <!-- 1. Lista blanca de rutas públicas y cabeceras HTTP seguras -->
  <filter>
    <filter-name>PublicAccessFilter</filter-name>
    <filter-class>com.brewlab.security.PublicAccessFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>PublicAccessFilter</filter-name>
    <url-pattern>/*</url-pattern>
    <dispatcher>REQUEST</dispatcher>
  </filter-mapping>

  <!-- 2. Verificación JWT (HttpOnly cookie) + CSRF por doble envío -->
  <filter>
    <filter-name>JwtAuthFilter</filter-name>
    <filter-class>com.brewlab.security.JwtAuthFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>JwtAuthFilter</filter-name>
    <url-pattern>/auth/*</url-pattern>
    <url-pattern>/app/*</url-pattern>
    <dispatcher>REQUEST</dispatcher>
  </filter-mapping>

  <!-- Controladores MVC -->
  <servlet>
    <servlet-name>AuthServlet</servlet-name>
    <servlet-class>com.brewlab.features.auth.AuthServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>AuthServlet</servlet-name>
    <url-pattern>/auth/login</url-pattern>
    <url-pattern>/auth/registro</url-pattern>
    <url-pattern>/auth/salir</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>DashboardServlet</servlet-name>
    <servlet-class>com.brewlab.features.dashboard.DashboardServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>DashboardServlet</servlet-name>
    <url-pattern>/app/inicio</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>CoffeeLibraryServlet</servlet-name>
    <servlet-class>com.brewlab.features.coffee.CoffeeLibraryServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>CoffeeLibraryServlet</servlet-name>
    <url-pattern>/app/cafes</url-pattern>
    <url-pattern>/app/cafes/lote</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>EquipmentWaterServlet</servlet-name>
    <servlet-class>com.brewlab.features.equipment.EquipmentWaterServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>EquipmentWaterServlet</servlet-name>
    <url-pattern>/app/equipos</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>RecipeServlet</servlet-name>
    <servlet-class>com.brewlab.features.recipes.RecipeServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>RecipeServlet</servlet-name>
    <url-pattern>/app/recetas</url-pattern>
    <url-pattern>/app/recetas/detalle</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>BrewAssistantServlet</servlet-name>
    <servlet-class>com.brewlab.features.brew.BrewAssistantServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>BrewAssistantServlet</servlet-name>
    <url-pattern>/app/preparacion</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>SensoryLabServlet</servlet-name>
    <servlet-class>com.brewlab.features.sensory.SensoryLabServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>SensoryLabServlet</servlet-name>
    <url-pattern>/app/catacion</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>AnalyticsServlet</servlet-name>
    <servlet-class>com.brewlab.features.analytics.AnalyticsServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>AnalyticsServlet</servlet-name>
    <url-pattern>/app/analisis</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>ExperimentServlet</servlet-name>
    <servlet-class>com.brewlab.features.experiments.ExperimentServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>ExperimentServlet</servlet-name>
    <url-pattern>/app/experimentos</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>SettingsServlet</servlet-name>
    <servlet-class>com.brewlab.features.settings.SettingsServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>SettingsServlet</servlet-name>
    <url-pattern>/app/ajustes</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>BackupServlet</servlet-name>
    <servlet-class>com.brewlab.features.backup.BackupServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>BackupServlet</servlet-name>
    <url-pattern>/app/respaldo</url-pattern>
  </servlet-mapping>

  <welcome-file-list>
    <welcome-file>index.jsp</welcome-file>
  </welcome-file-list>
</web-app>
